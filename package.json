{
  "name": "fire-your-coworkers",
  "version": "0.1.0",
  "private": true,
  "description": "Fire Your Coworkers web game and public preview",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @fyc/web dev",
    "build": "corepack pnpm --filter @fyc/web build",
    "build:static-preview": "corepack pnpm build && node scripts/build-static-preview.mjs",
    "start": "corepack pnpm --filter @fyc/web start",
    "test": "corepack pnpm --filter @fyc/web test",
    "typecheck": "corepack pnpm --filter @fyc/web typecheck"
  }
}
